    <actions>
        <action id="dev.owlmajin.project.switcher.ProjectSwitchAction"
                class="dev.owlmajin.project.switcher.ProjectSwitchAction"
                text="Switch Project">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt F2"/>
        </action>
    </actions>


