<idea-plugin>
    <id>org.jetbrains.plugins.compose.template</id>
    <name>Compose Template Example</name>
    <vendor url="https://github.com/WordyArc">owlmajin</vendor>

    <depends>com.intellij.modules.compose</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.ComposeTemplateBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="dev.owlmajin.project.switcher.toolWindow.ComposeSamplesToolWindowFactory"
                    icon="dev.owlmajin.project.switcher.toolWindow.ComposeIcons.ComposeToolWindow"
                    id="ComposeSamples"/>
    </extensions>

