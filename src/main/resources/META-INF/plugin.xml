<idea-plugin>
    <id>org.jetbrains.plugins.compose.template</id>
    <name>Project Switcher</name>
    <vendor url="https://github.com/WordyArc">owlmajin</vendor>

    <depends>com.intellij.modules.compose</depends>

    <actions>
        <action id="dev.owlmajin.project.switcher.ProjectSwitchAction"
                class="dev.owlmajin.project.switcher.ProjectSwitchAction"
                text="Switch Project">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt F2"/>
        </action>
    </actions>

</idea-plugin>
