<idea-plugin>
    <id>dev.ashenarx.project-switcher</id>
    <name>Project Switcher</name>
    <vendor email="ashenarx@gmail.com" url="https://github.com/WordyArc">ashenarx</vendor>

    <description><![CDATA[
        Switch between open and recent projects from a compact keyboard-driven popup.<br/>
        <br/>
        Type to filter projects by name or path. Search tolerates common typos and supports
        keyboard-layout correction.<br/>
        <br/>
        Press <kbd>Alt+F2</kbd> to open Project Switcher. Use <kbd>Enter</kbd> to switch, or
        <kbd>Delete</kbd> and <kbd>Backspace</kbd> to close or remove a project. The shortcut can be changed under
        <b>Settings | Keymap | Switch Project</b>.<br/>
        <br/>
        <!-- Absolute URLs: the Marketplace renders this description outside the repository. -->
        <img src="https://raw.githubusercontent.com/WordyArc/ProjectSwitcher/main/docs/images/popup.png"
             alt="The popup listing open projects above the recent ones" width="640"/><br/>
        <br/>
        <img src="https://raw.githubusercontent.com/WordyArc/ProjectSwitcher/main/docs/images/speed-search.png"
             alt="Typing narrows the list to the matching projects" width="640"/>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.compose</depends>

    <resource-bundle>messages.ProjectSwitcherBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Project Switcher"
                           displayType="BALLOON"
                           bundle="messages.ProjectSwitcherBundle"
                           key="notification.group.name"/>
    </extensions>

    <actions>
        <action id="ProjectSwitcher.SwitchProject"
                class="dev.ashenarx.project.switcher.intellij.ProjectSwitchAction"
                icon="/icons/switchProject.svg">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt F2"/>
        </action>
    </actions>
</idea-plugin>
